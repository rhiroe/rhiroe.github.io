{
  "name": "rhiroe.github.io",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && next-sitemap && npx tsx scripts/generate-feeds.ts",
    "build:github": "NODE_ENV=production GITHUB_ACTIONS=true next build && next-sitemap --config next-sitemap.config.js && npx tsx scripts/generate-feeds.ts",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "generate-feeds": "npx tsx scripts/generate-feeds.ts",
    "generate-sitemap": "next-sitemap",
    "update-deps": "npx tsx scripts/update-deps.ts --all",
    "update-deps:check": "npx tsx scripts/update-deps.ts --check",
    "update-deps:individual": "npx tsx scripts/update-deps.ts --individual",
    "update-package": "npx tsx scripts/update-deps.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/styled-engine-sc": "^7.1.0",
    "@octokit/rest": "^22.0.0",
    "feed": "^5.1.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.6.0",
    "next": "15.3.5",
    "next-sitemap": "^4.2.3",
    "playwright": "^1.54.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.0.2",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.30.1",
    "eslint-config-next": "15.3.4",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "30.0.2",
    "ts-jest": "^29.3.2",
    "tsx": "^4.19.4",
    "typescript": "5.8.3"
  }
}
