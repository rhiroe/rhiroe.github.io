{
  "name": "rhiroe.github.io",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "tsx scripts/generate-posts-index.ts && tsx scripts/generate-presentations-index.ts && vite",
    "build": "tsx scripts/generate-posts-index.ts && tsx scripts/generate-presentations-index.ts && tsc && vite build && tsx --tsconfig tsconfig.scripts.json scripts/generate-feeds.ts",
    "build:github": "NODE_ENV=production GITHUB_ACTIONS=true tsx scripts/generate-posts-index.ts && tsx scripts/generate-presentations-index.ts && tsc && vite build && tsx --tsconfig tsconfig.scripts.json scripts/generate-feeds.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "jest",
    "generate-feeds": "npx tsx --tsconfig tsconfig.scripts.json scripts/generate-feeds.ts",
    "update-deps": "npx tsx --tsconfig tsconfig.scripts.json scripts/update-deps.ts --all",
    "update-deps:check": "npx tsx --tsconfig tsconfig.scripts.json scripts/update-deps.ts --check",
    "update-deps:individual": "npx tsx --tsconfig tsconfig.scripts.json scripts/update-deps.ts --individual",
    "update-package": "npx tsx --tsconfig tsconfig.scripts.json scripts/update-deps.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.3.5",
    "@mui/styled-engine-sc": "^7.3.6",
    "@octokit/rest": "^22.0.1",
    "feed": "^5.2.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.12.0",
    "playwright": "^1.56.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.1.4",
    "recharts": "^3.6.0",
    "rehype-highlight": "^7.0.2",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "styled-components": "^6.1.18"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "25.1.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "9.39.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.1.2",
    "jest-environment-jsdom": "30.2.0",
    "ts-jest": "^29.3.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
